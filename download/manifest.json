  "changelog": [
    {
      "version": "0.24",
      "text": "The app. Lmg has its own little app now. Press Play and it updates everything, then opens Minecraft for you."
    },
    {
      "version": "0.23",
      "text": "Smoother. A new FPS tab, and the trail, ore glow and minimap do a lot less work."
    },
    {
      "version": "0.22",
      "text": "Cinematic. Golden-hour shaders in one click, a film mode on F7, and a proper colour picker."
    },
    {
      "version": "0.21",
      "text": "See each other's pets. Turn on sharing and other Lmg players can see your pets and cosmetics."
    },
    {
      "version": "0.20",
      "text": "Pets. 25 animals or a tiny version of anyone. Name them, put them on your shoulder."
    },
    {
      "version": "0.19",
      "text": "Safer by default. Freecam and ore glow stay off on servers. Real terms and privacy pages."
    }
  ],
